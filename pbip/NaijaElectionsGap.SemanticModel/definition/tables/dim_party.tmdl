		lineageTag: ed92fcdb-6d2b-6df0-837b-7199e90b26b5
		summarizeBy: none
		sourceColumn: party
		sortByColumn: sort_order

	column candidate
		dataType: string
		lineageTag: 6af7d17c-9b5b-f3ae-5377-3461ebbc231a
		summarizeBy: none
		sourceColumn: candidate
		sortByColumn: sort_order

	column party_name
		dataType: string
