- [@p2], 1 - [@p1] ), 0 ) ) VAR nb = SUMX ( t4, [@vb] * [@sc] ) VAR nu = IF ( uu <> "", SUMX ( t4, [@vu] * [@sc] ) ) VAR rx = IF ( uu = "" || nb > nu || ( nb = nu && bl < uu ), bl, uu ) VAR rv = IF ( rx = bl, nb, nu ) VAR rk = COUNTROWS ( FILTER ( t4, IF ( rx = bl, [@vb], [@vu] ) * [@sc] >= 0.25 * [@V1] ) ) + 0 VAR r = IF ( rx = bl && bp <> "NONE", bl & "+" & bp, rx ) VAR t5 = FILTER ( t4, [@tv] > 0 ) VAR a = SUMX ( t5, [@p2] * [@V1] ) VAR k = COUNTROWS ( FILTER ( t5, [@p2] >= ( 0.25 - 1E-12 ) ) ) + 0 VAR n = [Units needed (rule)] VAR m = IF ( NOT ISBLANK ( a ), IF ( a > rv, "Yes", IF ( a = rv, "Tied", "No" ) ) ) VAR c = IF ( k >= n, "Yes", "No" ) VAR rc = rk >= n VAR nm = [Engine candidate name] VAR rl = IF ( rx = bl, [Side B name], SWITCH ( rx, "APC", "Bola Tinubu (APC)", "PDP", "Atiku Abubakar — ADC now (PDP in 2023; ADC ticket under court challenge)", "LP", "Peter Obi — NDC now (LP in 2023)", "NNPP", "Rabiu Kwankwaso — NDC now, running mate to Peter Obi (NNPP in 2023)" ) ) RETURN SWITCH ( TRUE (), ISBLANK ( m ), BLANK (), m = "Yes" && c = "Yes", nm & " wins outright: the most votes nationwide and a quarter of the vote in " & k & " states (" & n & " needed).", m = "Yes", "No outright winner: " & nm & " has the most votes but a quarter of the vote in only " & k & " states (" & n & " needed). This would go to a run-off.", m = "Tied", "Tie on votes: no outright winner.", rc, nm & " loses: " & rl & " has the most votes and a quarter of the vote in enough states.", "No outright winner: " & rl & " has the most votes but not a quarter of the vote in enough states. This would go to a run-off." ) ), CALCULATE ( VAR m = [Has most votes] VAR c = [Clears the rule] VAR k = [Units secured (national)] VAR n = [Units needed (rule)] VAR nm = [Engine candidate name] VAR r = [Leading rival] VAR rl = IF ( [Coalition switch on], [Leading rival name], SWITCH ( r, "APC", "Bola Tinubu (APC)", "PDP", "Atiku Abubakar — ADC now (PDP in 2023; ADC ticket under court challenge)", "LP", "Peter Obi — NDC now (LP in 2023)", "NNPP", "Rabiu Kwankwaso — NDC now, running mate to Peter Obi (NNPP in 2023)" ) ) VAR rc = [Leading rival units at 25%] >= n RETURN SWITCH ( TRUE (), ISBLANK ( m ), BLANK (), m = "Yes" && c = "Yes", nm & " wins outright: the most votes nationwide and a quarter of the vote in " & k & " states (" & n & " needed).", m = "Yes", "No outright winner: " & nm & " has the most votes but a quarter of the vote in only " & k & " states (" & n & " needed). This would go to a run-off.", m = "Tied", "Tie on votes: no outright winner.", rc, nm & " loses: " & rl & " has the most votes and a quarter of the vote in enough states.", "No outright winner: " & rl & " has the most votes but not a quarter of the vote in enough states. This would go to a run-off." ), coal_switch[Value] = "Off" ) )
		lineageTag: d51994ed-8644-ab95-310c-31d9b6105eaa

	measure 'Closest calls sentence' = IF ( [Candidate is valid], VAR c = SELECTEDVALUE ( dim_party[candidate] ) VAR tb = CALCULATETABLE ( FILTER ( ADDCOLUMNS ( SUMMARIZE ( dim_state, dim_state[state_pcode], dim_state[state_name] ), "@v", [Candidate votes], "@t", [Valid votes] ), NOT ISBLANK ( [@v] ) && [@t] > 0 ), REMOVEFILTERS ( dim_state ), REMOVEFILTERS ( dim_zone ) ) VAR won = TOPN ( 1, FILTER ( tb, 4 * [@v] >= [@t] ), 4 * [@v] - [@t], ASC, dim_state[state_pcode], ASC ) VAR miss = TOPN ( 1, FILTER ( tb, 4 * [@v] < [@t] ), [@t] - 4 * [@v], ASC, dim_state[state_pcode], ASC ) VAR a = IF ( COUNTROWS ( won ) > 0, MAXX ( won, dim_state[state_name] ) & ", the narrowest state won, was about " & FORMAT ( MAXX ( won, ROUNDDOWN ( ( 4 * [@v] - [@t] ) / 4, 0 ) ), "#,0" ) & " votes above a quarter of the vote.", "No state reached a quarter of the vote." ) VAR b = IF ( COUNTROWS ( miss ) > 0, " " & MAXX ( miss, dim_state[state_name] ) & ", the narrowest miss, needed about " & FORMAT ( MAXX ( miss, ROUNDUP ( ( [@t] - 4 * [@v] ) / 4, 0 ) ), "#,0" ) & " more votes switching to " & c & " from other candidates.", " Every state reached a quarter of the vote." ) RETURN c & " in 2023: " & a & b )
