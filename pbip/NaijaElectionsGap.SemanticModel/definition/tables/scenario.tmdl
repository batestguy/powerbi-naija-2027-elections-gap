	measure 'Tile fill' = VAR p = [Points from 25%] RETURN IF ( NOT ISBLANK ( p ) && HASONEVALUE ( dim_state[state_pcode] ), VAR f = MIN ( 1, ABS ( p ) / 25 ) VAR r = ROUND ( IF ( p < 0, 242 + ( 213 - 242 ) * f, 242 + ( 0 - 242 ) * f ), 0 ) VAR g = ROUND ( IF ( p < 0, 242 + ( 94 - 242 ) * f, 242 + ( 114 - 242 ) * f ), 0 ) VAR b = ROUND ( IF ( p < 0, 242 + ( 0 - 242 ) * f, 242 + ( 178 - 242 ) * f ), 0 ) VAR hx = "0123456789ABCDEF" RETURN "#" & MID ( hx, INT ( r / 16 ) + 1, 1 ) & MID ( hx, MOD ( r, 16 ) + 1, 1 ) & MID ( hx, INT ( g / 16 ) + 1, 1 ) & MID ( hx, MOD ( g, 16 ) + 1, 1 ) & MID ( hx, INT ( b / 16 ) + 1, 1 ) & MID ( hx, MOD ( b, 16 ) + 1, 1 ) )
		lineageTag: 59b49760-896b-b8e6-6303-0550f8fc5f9c

	measure 'Tile text colour' = VAR p = [Points from 25%] RETURN IF ( NOT ISBLANK ( p ) && HASONEVALUE ( dim_state[state_pcode] ), VAR f = MIN ( 1, ABS ( p ) / 25 ) VAR r = ROUND ( IF ( p < 0, 242 + ( 213 - 242 ) * f, 242 + ( 0 - 242 ) * f ), 0 ) / 255 VAR g = ROUND ( IF ( p < 0, 242 + ( 94 - 242 ) * f, 242 + ( 114 - 242 ) * f ), 0 ) / 255 VAR b = ROUND ( IF ( p < 0, 242 + ( 0 - 242 ) * f, 242 + ( 178 - 242 ) * f ), 0 ) / 255 VAR lr = IF ( r <= 0.03928, r / 12.92, POWER ( ( r + 0.055 ) / 1.055, 2.4 ) ) VAR lg = IF ( g <= 0.03928, g / 12.92, POWER ( ( g + 0.055 ) / 1.055, 2.4 ) ) VAR lb = IF ( b <= 0.03928, b / 12.92, POWER ( ( b + 0.055 ) / 1.055, 2.4 ) ) VAR l = 0.2126 * lr + 0.7152 * lg + 0.0722 * lb RETURN IF ( 1.05 / ( l + 0.05 ) > ( l + 0.05 ) / 0.05, "#FFFFFF", "#000000" ) )
