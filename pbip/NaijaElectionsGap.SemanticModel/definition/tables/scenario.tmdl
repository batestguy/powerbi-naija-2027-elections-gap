[@p2], 1 - [@p1] ), 0 ) ) VAR nb = SUMX ( t4, [@vb] * [@sc] ) VAR nu = IF ( uu <> "", SUMX ( t4, [@vu] * [@sc] ) ) VAR rx = IF ( uu = "" || nb > nu || ( nb = nu && bl < uu ), bl, uu ) RETURN IF ( rx = bl && bp <> "NONE", bl & "+" & bp, rx ) ), CALCULATE ( IF ( [Candidate is valid], VAR c = SELECTEDVALUE ( dim_party[party] ) VAR tab = ADDCOLUMNS ( FILTER ( { "APC", "PDP", "LP", "NNPP" }, [Value] <> c ), "@v", VAR r = [Value] RETURN CALCULATE ( SUMX ( VALUES ( dim_state[state_pcode] ), CALCULATE ( SUM ( fact_result_2023[votes] ), fact_result_2023[party] = r ) * [Rival scale] ), REMOVEFILTERS ( dim_state ), REMOVEFILTERS ( dim_zone ) ) ) VAR top1 = TOPN ( 1, tab, [@v], DESC, [Value], ASC ) RETURN MAXX ( top1, [Value] ) ), coal_switch[Value] = "Off" ) )
