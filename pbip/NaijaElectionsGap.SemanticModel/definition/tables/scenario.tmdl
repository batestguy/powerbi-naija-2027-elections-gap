table scenario
	lineageTag: a442799d-9f11-f602-9bc1-22ab023ec651

	measure 'Supporter turnout' = SELECTEDVALUE ( param_turnout[Value], 0 ) / 100
		formatString: 0%
		lineageTag: bb1fbb9f-5b38-a045-9c82-c9435f905716

	measure 'National swing' = SELECTEDVALUE ( param_swing_national[Value], 0 )
		formatString: +0.0;-0.0;0.0
		lineageTag: b62d6f54-61af-3ca2-afcb-7ae37fb899b3

	measure 'Zone swing' = SWITCH ( SELECTEDVALUE ( dim_state[zone_code] ), "NC", SELECTEDVALUE ( param_swing_NC[Value], 0 ), "NE", SELECTEDVALUE ( param_swing_NE[Value], 0 ), "NW", SELECTEDVALUE ( param_swing_NW[Value], 0 ), "SE", SELECTEDVALUE ( param_swing_SE[Value], 0 ), "SS", SELECTEDVALUE ( param_swing_SS[Value], 0 ), "SW", SELECTEDVALUE ( param_swing_SW[Value], 0 ) )
		formatString: +0.0;-0.0;0.0
		lineageTag: 097de3dc-87f4-a3dd-50bf-7cf5f1c11fe2

	measure 'Units needed (rule)' = SELECTEDVALUE ( param_rule[Value], 24 )
		formatString: 0
		lineageTag: 1e4a6c5f-cc89-6b20-80ff-45c0afd621a3

	measure 'Candidate is valid' = VAR c = SELECTEDVALUE ( dim_party[party] ) RETURN NOT ISBLANK ( c ) && c <> "OTHERS"
		lineageTag: a458d06b-8d02-edef-0e62-6991497e6aa2

	measure 'Scenario valid votes' = VAR cv = [Candidate votes] VAR tv = [Valid votes] RETURN IF ( [Candidate is valid] && HASONEVALUE ( dim_state[state_pcode] ) && NOT ISBLANK ( cv ) && tv > 0, tv + cv * [Supporter turnout] )
		formatString: #,0
		lineageTag: 70821635-4b6a-a2ae-37ec-be0eea278d3a

	measure 'Scenario share uncapped' = VAR cv = [Candidate votes] VAR tv = [Valid votes] VAR t = [Supporter turnout] RETURN IF ( [Candidate is valid] && HASONEVALUE ( dim_state[state_pcode] ) && NOT ISBLANK ( cv ) && tv > 0, DIVIDE ( cv * ( 1 + t ), tv + cv * t ) + ( [National swing] + [Zone swing] ) / 100 )
		formatString: 0.00%
		lineageTag: 45a6d835-f06c-36f7-546b-61408f84449f

	measure 'Scenario share' = VAR u = [Scenario share uncapped] RETURN IF ( NOT ISBLANK ( u ), MIN ( 1, MAX ( 0, u ) ) )
		formatString: 0.00%
		lineageTag: a58063bc-0798-165b-379e-403d43380ff7

	measure 'Scenario votes' = [Scenario share] * [Scenario valid votes]
		formatString: #,0
		lineageTag: a6921596-217f-360d-33ca-d1f7b2aef194

	measure 'Scenario label' = VAR p = [Scenario share] RETURN SWITCH ( TRUE (), ISBLANK ( p ), BLANK (), p >= 0.25, "Secured", p >= 0.20, "Within reach", "Out of reach" )
		lineageTag: 9b645e5d-bd35-29c3-46ae-51114ced6d34

	measure 'Scenario label order' = VAR p = [Scenario share] RETURN SWITCH ( TRUE (), ISBLANK ( p ), BLANK (), p >= 0.25, 1, p >= 0.20, 2, 3 )
		formatString: 0
		lineageTag: 1c529bab-cc0d-0fe2-0a34-bb253b7efa38

	measure 'Points needed' = VAR p = [Scenario share] RETURN IF ( NOT ISBLANK ( p ), MAX ( 0, 0.25 - p ) * 100 )
		formatString: 0.0
		lineageTag: dddc7ed4-1202-aab9-fec2-da7f2814583e

	measure 'Votes needed' = VAR p = [Scenario share] RETURN IF ( NOT ISBLANK ( p ), ROUNDUP ( MAX ( 0, 0.25 * [Scenario valid votes] - [Scenario votes] ), 0 ) )
		formatString: #,0
		lineageTag: ffb73f03-541b-1a43-8ad0-f92ba61f4074

	measure 'Units secured' = IF ( [Candidate is valid], COUNTROWS ( FILTER ( VALUES ( dim_state[state_pcode] ), [Scenario share] >= 0.25 ) ) + 0 )
		formatString: 0
		lineageTag: 2d13b105-8597-ad0f-e098-7e31aaa2e35b

	measure 'Units within reach' = IF ( [Candidate is valid], COUNTROWS ( FILTER ( VALUES ( dim_state[state_pcode] ), [Scenario share] >= 0.20 && [Scenario share] < 0.25 ) ) + 0 )
		formatString: 0
		lineageTag: 84be9939-71ce-c680-9c27-c17e554d322b

	measure 'Units out of reach' = IF ( [Candidate is valid], COUNTROWS ( FILTER ( VALUES ( dim_state[state_pcode] ), NOT ISBLANK ( [Scenario share] ) && [Scenario share] < 0.20 ) ) + 0 )
		formatString: 0
		lineageTag: bebd805e-704a-72ea-7e30-ecd622e8a6de

	measure 'Units with a scenario' = IF ( [Candidate is valid], COUNTROWS ( FILTER ( VALUES ( dim_state[state_pcode] ), NOT ISBLANK ( [Scenario share] ) ) ) + 0 )
		formatString: 0
		lineageTag: 757e99d6-4f2c-3114-7ffa-34752374ec15

	measure 'Units at a cap' = IF ( [Candidate is valid], COUNTROWS ( FILTER ( VALUES ( dim_state[state_pcode] ), VAR u = [Scenario share uncapped] RETURN NOT ISBLANK ( u ) && ( u <= 0 || u >= 1 ) ) ) + 0 )
		formatString: 0
		lineageTag: 61a8a036-56bc-d91b-04cb-37029276003d

	measure 'Units secured (national)' = CALCULATE ( [Units secured], REMOVEFILTERS ( dim_state ), REMOVEFILTERS ( dim_zone ) )
		formatString: 0
		lineageTag: bcac899c-c564-f338-d72e-3e0932bed155

	measure 'Units still needed' = IF ( [Candidate is valid], MAX ( 0, [Units needed (rule)] - [Units secured (national)] ) )
		formatString: 0
		lineageTag: fee32701-13fd-0b1f-6277-81b6439fa34e

	measure 'Clears the rule' = IF ( [Candidate is valid], IF ( [Units secured (national)] >= [Units needed (rule)], "Yes", "No" ) )
		lineageTag: 8bbbfd4e-4a13-d324-95c7-221581f08ea2

	measure 'Tipping-point P-code' = IF ( [Candidate is valid], VAR n = [Units needed (rule)] RETURN CALCULATE ( VAR tb = FILTER ( ADDCOLUMNS ( VALUES ( dim_state[state_pcode] ), "@p", [Scenario share] ), NOT ISBLANK ( [@p] ) ) VAR tp = TOPN ( n, tb, [@p], DESC, dim_state[state_pcode], ASC ) RETURN IF ( COUNTROWS ( tb ) >= n, MAXX ( TOPN ( 1, tp, [@p], ASC, dim_state[state_pcode], DESC ), dim_state[state_pcode] ) ), REMOVEFILTERS ( dim_state ), REMOVEFILTERS ( dim_zone ) ) )
		lineageTag: 671f8d66-0d83-e9a0-1d17-d2089c4bea7e

	measure 'Tipping-point unit' = VAR k = [Tipping-point P-code] RETURN IF ( NOT ISBLANK ( k ), LOOKUPVALUE ( dim_state[state_name], dim_state[state_pcode], k ) )
		lineageTag: f582f47d-47fc-0a4e-4f00-29e400677c91

	measure 'Tipping-point share' = VAR k = [Tipping-point P-code] RETURN IF ( NOT ISBLANK ( k ), CALCULATE ( [Scenario share], REMOVEFILTERS ( dim_state ), REMOVEFILTERS ( dim_zone ), dim_state[state_pcode] = k ) )
		formatString: 0.00%
		lineageTag: 57b20f55-a638-3110-76ad-2aba9e91d520

	measure 'Tipping-point gap (points)' = VAR p = [Tipping-point share] RETURN IF ( NOT ISBLANK ( p ), ( 0.25 - p ) * 100 )
		formatString: +0.0;-0.0;0.0
		lineageTag: f52a752f-27ae-9616-0644-ad9a83397a9d

	measure 'Scenario share after turnout' = VAR cv = [Candidate votes] VAR tv = [Valid votes] VAR t = [Supporter turnout] RETURN IF ( [Candidate is valid] && HASONEVALUE ( dim_state[state_pcode] ) && NOT ISBLANK ( cv ) && tv > 0, DIVIDE ( cv * ( 1 + t ), tv + cv * t ) )
		formatString: 0.00%
		lineageTag: 589dde70-2545-8b71-5109-492b8d83b16a

	measure 'Rival scale' = VAR p1 = [Scenario share after turnout] VAR p2 = [Scenario share] RETURN IF ( NOT ISBLANK ( p2 ), IF ( p1 < 1, DIVIDE ( 1 - p2, 1 - p1 ), 0 ) )
		formatString: 0.0000
		lineageTag: 96c00d05-6776-f84e-ed58-ed128438c4c2

	measure 'Scenario national votes' = IF ( [Candidate is valid], CALCULATE ( SUMX ( VALUES ( dim_state[state_pcode] ), [Scenario votes] ), REMOVEFILTERS ( dim_state ), REMOVEFILTERS ( dim_zone ) ) )
		formatString: #,0
		lineageTag: 7ddf0733-16f6-34c0-3c2c-db8f029a6768

	measure 'Scenario national valid votes' = IF ( [Candidate is valid], CALCULATE ( SUMX ( VALUES ( dim_state[state_pcode] ), [Scenario valid votes] ), REMOVEFILTERS ( dim_state ), REMOVEFILTERS ( dim_zone ) ) )
		formatString: #,0
		lineageTag: f46f2980-dc0a-045b-e19c-e0cf1c6e7db9

	measure 'Scenario national share' = DIVIDE ( [Scenario national votes], [Scenario national valid votes] )
		formatString: 0.00%
		lineageTag: f9290ca2-0616-4fa3-e452-944875f3d2b6

	measure 'Leading rival' = IF ( [Candidate is valid], VAR c = SELECTEDVALUE ( dim_party[party] ) VAR tab = ADDCOLUMNS ( FILTER ( { "APC", "PDP", "LP", "NNPP" }, [Value] <> c ), "@v", VAR r = [Value] RETURN CALCULATE ( SUMX ( VALUES ( dim_state[state_pcode] ), CALCULATE ( SUM ( fact_result_2023[votes] ), fact_result_2023[party] = r ) * [Rival scale] ), REMOVEFILTERS ( dim_state ), REMOVEFILTERS ( dim_zone ) ) ) VAR top1 = TOPN ( 1, tab, [@v], DESC, [Value], ASC ) RETURN MAXX ( top1, [Value] ) )
		lineageTag: cb32af95-d099-888d-948e-6306d1af32a4

	measure 'Leading rival votes' = IF ( [Candidate is valid], VAR c = SELECTEDVALUE ( dim_party[party] ) VAR tab = ADDCOLUMNS ( FILTER ( { "APC", "PDP", "LP", "NNPP" }, [Value] <> c ), "@v", VAR r = [Value] RETURN CALCULATE ( SUMX ( VALUES ( dim_state[state_pcode] ), CALCULATE ( SUM ( fact_result_2023[votes] ), fact_result_2023[party] = r ) * [Rival scale] ), REMOVEFILTERS ( dim_state ), REMOVEFILTERS ( dim_zone ) ) ) RETURN MAXX ( tab, [@v] ) )
		formatString: #,0
		lineageTag: 0c8f7980-edde-d2cd-bde9-f1d3bbd66ca0

	measure 'Leading rival units at 25%' = VAR r = [Leading rival] RETURN IF ( NOT ISBLANK ( r ), CALCULATE ( COUNTROWS ( FILTER ( VALUES ( dim_state[state_pcode] ), CALCULATE ( SUM ( fact_result_2023[votes] ), fact_result_2023[party] = r ) * [Rival scale] >= 0.25 * [Scenario valid votes] ) ), REMOVEFILTERS ( dim_state ), REMOVEFILTERS ( dim_zone ) ) + 0 )
		formatString: 0
		lineageTag: 131eff5d-8b4a-89ff-0db2-f637de8a5ffe

	measure 'Has most votes' = VAR a = [Scenario national votes] VAR b = [Leading rival votes] RETURN IF ( NOT ISBLANK ( a ), IF ( a > b, "Yes", IF ( a = b, "Tied", "No" ) ) )
		lineageTag: 4e25a744-e3c4-0da8-57bd-3d5a6463ef81

	measure 'Verdict' = VAR m = [Has most votes] VAR c = [Clears the rule] VAR r = [Leading rival] VAR rc = [Leading rival units at 25%] >= [Units needed (rule)] RETURN SWITCH ( TRUE (), ISBLANK ( m ), BLANK (), m = "Yes" && c = "Yes", "Outright win", m = "Yes", "No outright winner: run-off (most votes, but not 25% in enough units)", m = "Tied", "Tie on votes: no outright winner", rc, "Loses: " & r & " wins outright", "No outright winner: run-off (" & r & " has most votes)" )
		lineageTag: 5418c2a8-6113-3f97-37f5-0570837d9fe4

	measure 'Points from 25%' = VAR p = [Scenario share] RETURN IF ( NOT ISBLANK ( p ), ( p - 0.25 ) * 100 )
		formatString: +0.0;-0.0;0.0
		lineageTag: 007045d6-c2c3-8f8b-a6ec-e3c694900a26

	measure 'Scenario label colour' = VAR p = [Scenario share] RETURN SWITCH ( TRUE (), ISBLANK ( p ), BLANK (), p >= 0.25, "#0072B2", p >= 0.20, "#D55E00", "#767676" )
		lineageTag: d6d9149f-9d66-2882-1d21-c892b529afa3

	measure 'Baseline label colour' = VAR cv = [Candidate votes] VAR tv = [Valid votes] RETURN SWITCH ( TRUE (), ISBLANK ( cv ) || ISBLANK ( tv ) || tv = 0, BLANK (), 4 * cv >= tv, "#0072B2", 5 * cv >= tv, "#D55E00", "#767676" )
		lineageTag: 9fd95110-5960-39ef-f40d-88cefb01a0fb

	measure 'Candidate national rank' = CALCULATE ( VAR c = SELECTEDVALUE ( dim_party[party] ) VAR mine = [Candidate votes] RETURN IF ( [Candidate is valid] && NOT ISBLANK ( mine ), COUNTROWS ( FILTER ( { "APC", "PDP", "LP", "NNPP" }, VAR r = [Value] RETURN r <> c && CALCULATE ( [Total votes], fact_result_2023[party] = r ) > mine ) ) + 1 ), REMOVEFILTERS ( dim_state ), REMOVEFILTERS ( dim_zone ) )
		formatString: 0
		lineageTag: 6191cdf9-b3ee-27ba-e723-246ee4869fbf

	measure 'Baseline label' = VAR cv = [Candidate votes] VAR tv = [Valid votes] RETURN SWITCH ( TRUE (), ISBLANK ( cv ) || ISBLANK ( tv ) || tv = 0, BLANK (), 4 * cv >= tv, "Secured", 5 * cv >= tv, "Within reach", "Out of reach" )
		lineageTag: 036e7412-b5d3-33ac-21a9-6f92408a7f8e

	measure 'Unit rank' = VAR me = SELECTEDVALUE ( dim_state[state_pcode] ) VAR p = [Scenario share] RETURN IF ( NOT ISBLANK ( p ) && NOT ISBLANK ( me ), CALCULATE ( COUNTROWS ( FILTER ( VALUES ( dim_state[state_pcode] ), VAR q = [Scenario share] RETURN q > p || ( q = p && dim_state[state_pcode] < me ) ) ), REMOVEFILTERS ( dim_state ), REMOVEFILTERS ( dim_zone ) ) + 1 )
		formatString: 0
		lineageTag: 90f2dcff-f03b-2e34-16bf-e13876d492e7

	measure 'Path column colour' = VAR k = [Tipping-point P-code] RETURN IF ( NOT ISBLANK ( k ) && SELECTEDVALUE ( dim_state[state_pcode] ) = k, "#1F1F1F", [Scenario label colour] )
		lineageTag: 0ef93e0f-5b24-4721-f7b7-760e596d2cde

	measure 'Assumptions in force' = IF ( [Candidate is valid], "Supporter turnout " & FORMAT ( [Supporter turnout], "+0%;-0%;0%" ) & " | national swing " & FORMAT ( [National swing], "+0.0;-0.0;0.0" ) & " pts | zones " & "NC " & FORMAT ( SELECTEDVALUE ( param_swing_NC[Value], 0 ), "+0.0;-0.0;0.0" ) & ", " & "NE " & FORMAT ( SELECTEDVALUE ( param_swing_NE[Value], 0 ), "+0.0;-0.0;0.0" ) & ", " & "NW " & FORMAT ( SELECTEDVALUE ( param_swing_NW[Value], 0 ), "+0.0;-0.0;0.0" ) & ", " & "SE " & FORMAT ( SELECTEDVALUE ( param_swing_SE[Value], 0 ), "+0.0;-0.0;0.0" ) & ", " & "SS " & FORMAT ( SELECTEDVALUE ( param_swing_SS[Value], 0 ), "+0.0;-0.0;0.0" ) & ", " & "SW " & FORMAT ( SELECTEDVALUE ( param_swing_SW[Value], 0 ), "+0.0;-0.0;0.0" ) & " | rule: " & [Units needed (rule)] & " of 37 units" )
		lineageTag: 4d39de29-1992-c6e3-7d9d-b1a48bda6335

	column Value
		dataType: string
		isHidden
		lineageTag: 6a6025d0-4194-b193-3aaf-92b34d621206
		summarizeBy: none
		sourceColumn: [Value]

	partition scenario = calculated
		mode: import
		source = { "Scenario measures - see docs/methodology.md" }

