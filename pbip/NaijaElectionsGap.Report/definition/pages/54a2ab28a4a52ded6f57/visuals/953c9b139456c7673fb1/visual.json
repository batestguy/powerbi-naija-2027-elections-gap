                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "'Short of 25%' at the tipping point: negative means above 25%. Outright win = most votes and 25% in the needed number of units. Run-off = nobody meets both. 'Loses' = a rival meets both. Who would contest a run-off is not modelled.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Map: blue above 25%, vermillion below, near-white at 25%; hover a tile for its share and label. Units at a cap means a slider pushed a share past 0% or 100% and it was held there.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
