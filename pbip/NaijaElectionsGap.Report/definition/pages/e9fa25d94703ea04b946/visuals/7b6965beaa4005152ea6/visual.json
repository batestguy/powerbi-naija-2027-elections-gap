          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Colour key: blue = 25% or more (secured); vermillion (dark orange) = 20% to under 25% (within reach); grey = under 20% (out of reach). The dashed line marks 25%. Hover a column for its label and share; the Path to 24 page lists every unit with its label in words.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "The rule counts 37 units: the 36 states plus the FCT. Without the FCT, Peter Obi has 15 units, not 16.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Notes on specific candidates. Close calls: Tinubu is 96 votes above 25% in Adamawa and 845.5 below in Edo. Valid votes carry an unexplained 4,858-vote excess in the minor-candidates column, larger than the Adamawa margin, so 29 could be 28 or 30.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Kano (Tinubu): 506,412 used; three of four copies print 517,341. Either way he is above 25% there.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
