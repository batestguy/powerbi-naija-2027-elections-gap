    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Assumptions. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  },
                  {
                    "value": "How many partner voters follow is an assumption; no published figure exists. Those who do not follow stay home.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Recombined 2023 votes, ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  },
                  {
                    "value": "not a 2027 forecast. Parties on neither side keep their 2023 votes; the 14 minor candidates are never counted as a leader.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Real or what-if: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  },
                  {
                    "value": "only \"NDC (Obi + Kwankwaso)\" is a real joint ticket. To try it with 2027 swings, open the What-if simulator and set \"Use the coalition?\" to On.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
