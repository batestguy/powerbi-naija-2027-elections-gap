    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What this page assumes. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  },
                  {
                    "value": "How many of the partner's voters follow is an assumption, not a measurement: no published figure exists. The 2011 to 2015 APC merger only loosely suggests that most partner voters followed.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Partner voters who do not follow stay home: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  },
                  {
                    "value": "none go to another party, so the state's total shrinks.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "2023 votes recombined, ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  },
                  {
                    "value": "not a 2027 forecast. Every other party keeps its 2023 votes. No swing, no turnout change (the What-if simulator adds those when its coalition switch is On).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Names: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  },
                  {
                    "value": "\"NDC (Obi + Kwankwaso)\" is a real joint ticket (NDC, 31 May 2026). Every other pairing is hypothetical and named \"X + Y (what-if)\".",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
