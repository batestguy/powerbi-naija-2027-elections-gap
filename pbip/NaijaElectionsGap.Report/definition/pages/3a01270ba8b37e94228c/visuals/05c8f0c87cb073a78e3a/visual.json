                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "The deciding state: ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  },
                  {
                    "value": "the 24th (or 25th) strongest state.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
