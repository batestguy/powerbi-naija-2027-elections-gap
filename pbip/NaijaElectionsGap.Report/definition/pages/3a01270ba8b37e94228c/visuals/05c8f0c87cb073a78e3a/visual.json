                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Tipping-point unit: rank all 37 units by share; it is the unit in position 24 - the weakest one the candidate needs (a negative 'short of 25%' means it is already above 25%). Votes to switch: votes that would have to move to the candidate from others, with the unit's total unchanged.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
