                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "More states needed = N − states won",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
