                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "9pt",
                      "color": "#1F1F1F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "25 = two-thirds of 37, rounded up (Abuja counts as one of the 37); 24 = two-thirds of the 36 states. Default 25.",
